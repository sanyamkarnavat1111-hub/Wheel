---
import '../styles/global.css';
import SpaceBackground from '../components/SpaceBackground.jsx';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-18NDWS5Z3L"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-18NDWS5Z3L');
  </script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>500 - Cosmic Interference | AstroWheel</title>
  <meta name="description" content="We are experiencing cosmic interference. Please try again shortly.">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="manifest" href="/site.webmanifest">
</head>
<body class="bg-[#07070b] overflow-x-hidden text-[#f0eef7]">
  <div class="astrowheel-root min-h-screen w-full flex items-center justify-center relative">
    <SpaceBackground client:only="react" />
    
    <div class="relative z-10 text-center px-4 max-w-xl mx-auto flex flex-col items-center">
      <div class="w-20 h-20 mb-6 rounded-2xl flex items-center justify-center anim-float-orb" style="border: 1px solid rgba(139,123,255,0.4); background: rgba(139,123,255,0.08); box-shadow: 0 0 30px rgba(139,123,255,0.12); animation-duration: 4s;">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#8b7bff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m11 7-3.2 4.4a2.1 2.1 0 0 0 .5 2.7 2.1 2.1 0 0 0 2.7.5L16 11"/><path d="M11 17a4.9 4.9 0 0 0 6.9-6.9"/><path d="M6 13a5 5 0 0 1 5-5"/></svg>
      </div>
      
      <h1 class="text-6xl sm:text-7xl font-bold font-display text-transparent bg-clip-text bg-gradient-to-r from-white to-white/60 mb-4">500</h1>
      <h2 class="text-xl sm:text-2xl font-semibold mb-3">Cosmic Interference</h2>
      <p class="text-[#7d7c8e] mb-8 text-sm sm:text-base leading-relaxed">
        The stars are momentarily clouded and our servers are experiencing unexpected interference. Please try again shortly.
      </p>
      
      <a href="/" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-sm font-semibold transition-transform active:scale-95 hover:brightness-110" style="background: linear-gradient(135deg, #8b7bff, #4c3a8a); color: #fff; box-shadow: 0 0 20px rgba(139,123,255,0.25);">
        Retry Connection
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>
      </a>
    </div>
  </div>
</body>
</html>
