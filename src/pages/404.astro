---
import '../styles/global.css';
import SpaceBackground from '../components/SpaceBackground.jsx';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>404 - Page Not Found | AstroWheel</title>
  <meta name="description" content="The celestial page you are looking for has been lost in the cosmos. Return to AstroWheel to continue your journey.">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="manifest" href="/site.webmanifest">
</head>
<body class="bg-[#07070b] overflow-x-hidden text-[#f0eef7]">
  <div class="astrowheel-root min-h-screen w-full flex items-center justify-center relative">
    <SpaceBackground client:only="react" />
    
    <div class="relative z-10 text-center px-4 max-w-xl mx-auto flex flex-col items-center">
      <div class="w-20 h-20 mb-6 rounded-2xl flex items-center justify-center anim-float-orb" style="border: 1px solid rgba(232,184,102,0.4); background: rgba(232,184,102,0.08); box-shadow: 0 0 30px rgba(232,184,102,0.12); animation-duration: 4s;">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#e8b866" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      </div>
      
      <h1 class="text-6xl sm:text-7xl font-bold font-display text-transparent bg-clip-text bg-gradient-to-r from-white to-white/60 mb-4">404</h1>
      <h2 class="text-xl sm:text-2xl font-semibold mb-3">Lost in the Cosmos</h2>
      <p class="text-[#7d7c8e] mb-8 text-sm sm:text-base leading-relaxed">
        The celestial alignment you seek cannot be found. The stars may have shifted, or the path was mistyped.
      </p>
      
      <a href="/" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-sm font-semibold transition-transform active:scale-95 hover:brightness-110" style="background: linear-gradient(135deg, #e8b866, #cf9a67); color: #0b0a12; box-shadow: 0 0 20px rgba(232,184,102,0.25);">
        Return to Earth
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      </a>
    </div>
  </div>
</body>
</html>
