---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.jsx';
---

<Layout title="Contact Us | AstroWheel – AI Astrology Support">
  <head>
    <meta name="description" content="Contact AstroWheel for support, feedback, or bug reports. We are the team behind your free AI Vedic astrologer – reach out anytime." />
    <link rel="canonical" href="https://freeastrologer.online/contact" />
    <meta property="og:title" content="Contact Us | AstroWheel – AI Astrology Support" />
    <meta property="og:description" content="Contact AstroWheel for support, feedback, or bug reports. We are the team behind your free AI Vedic astrologer." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://freeastrologer.online/contact" />
    <meta property="og:image" content="https://freeastrologer.online/og-banner.jpg" />
    <meta property="og:site_name" content="AstroWheel" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Contact AstroWheel – AI Astrology Support" />
    <meta name="twitter:description" content="Reach out to AstroWheel for support, feedback, or bug reports." />
    <meta name="twitter:image" content="https://freeastrologer.online/og-banner.jpg" />
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://freeastrologer.online/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Contact Us",
          "item": "https://freeastrologer.online/contact"
        }
      ]
    }
    </script>
  </head>
  <div class="min-h-screen text-[#f0eef7] flex flex-col font-sans">
    <header class="w-full border-b border-white/10 py-4 bg-[#07070b]/80 backdrop-blur-md sticky top-0 z-50">
      <div class="max-w-4xl mx-auto px-6">
        <a href="/" class="text-2xl font-display font-bold bg-clip-text text-transparent bg-gradient-to-r from-[#e8b866] to-[#cf9a67]">AstroWheel</a>
      </div>
    </header>

    <main class="flex-1 max-w-4xl mx-auto px-6 py-12">
      <h1 class="text-4xl sm:text-5xl font-display font-bold mb-8">Contact Us</h1>
      <div class="space-y-6 text-[#7d7c8e] leading-relaxed">
        <p>
          We're always here to help you navigate the cosmos. If you have any questions, feedback, or need support with AstroWheel, please don't hesitate to reach out to us.
        </p>

        <div class="bg-[#111119] border border-white/10 rounded-2xl p-6 mt-8">
          <h2 class="text-xl text-white font-semibold mb-4">Get in Touch</h2>
          <p class="mb-2"><strong>Company:</strong> Artificial Grrow</p>
          <p class="mb-4"><strong>Email Support:</strong> <a href="mailto:sanyam.karnavat5@gmail.com" class="text-[#8b7bff] hover:underline">sanyam.karnavat5@gmail.com</a></p>
          <p class="text-sm mt-4 italic">
            We aim to respond to all cosmic inquiries within 24-48 business hours. 
          </p>
        </div>

        <h2 class="text-2xl text-white font-semibold mt-8 mb-4">Feedback & Bug Reports</h2>
        <p>
          If you encounter any issues where the AI Astrologer is not responding or the Fortune Wheel is stuck, please send us an email with the subject line <strong>"Bug Report"</strong> so we can prioritize fixing the alignment of the stars for you!
        </p>

      </div>
    </main>

    <Footer />
  </div>
</Layout>
